# Environment Variables
# Create a .env file in your frontend directory with these variables

# Supabase Configuration (Frontend)
# Only anon key should be exposed to frontend - no service role key!
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# MSG91 OTP Configuration
VITE_MSG91_AUTH_KEY=your_msg91_auth_key_here
VITE_MSG91_WIDGET_ID=your_msg91_widget_id_here
VITE_MSG91_TOKEN_AUTH=your_msg91_token_auth_here

# Razorpay Configuration (Frontend)
# Only the Key ID should be exposed to frontend - never the secret!
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id_here

# BigShip Configuration (Frontend)
VITE_BIGSHIP_WAREHOUSE_ID=your_warehouse_id_here
VITE_PICKUP_PINCODE=your_pickup_pincode_here

# Backend API URL
# Development: http://localhost:8000
# Production: https://your-backend-url.onrender.com
VITE_API_BASE_URL=http://localhost:8000

# Note: DO NOT include service role keys or secrets in frontend environment variables
# Service role keys should only be in backend environment (.env in backend folder)